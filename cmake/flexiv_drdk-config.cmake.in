include(CMakeFindDependencyMacro)

# Find dependencies.
# DRDK is shipped as a self-contained shared library: its thirdparty dependencies are statically
# embedded and symbol-hidden, so a user application does not need to find them. flexiv_rdk stays a
# dependency because rdk:: types appear in the public flexiv::drdk API.
find_dependency(flexiv_rdk REQUIRED)

# Add targets file
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")
